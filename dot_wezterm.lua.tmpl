local wezterm = require("wezterm")

-- Read active theme from ~/.config/themes/current and load its wezterm.lua
-- (falls back to gruvbox when the themes dir isn't deployed, e.g. on windows)
local function load_theme()
	local themes_dir = wezterm.home_dir .. "/.config/themes"
	local theme = "cyberdream"
	local f = io.open(themes_dir .. "/current", "r")
	if f then
		theme = (f:read("*l") or "cyberdream"):gsub("%s+", "")
		f:close()
	end
	local ok, theme_cfg = pcall(dofile, themes_dir .. "/" .. theme .. "/wezterm.lua")
	if ok and type(theme_cfg) == "table" then
		return theme_cfg
	end
	return { color_scheme = "Gruvbox Dark (Gogh)" }
end

