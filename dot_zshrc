PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
export PATH="$HOME/.local/bin:$PATH"  # theme-switch, tmux-park-toggle, claude

if [ -d "$HOME/.pyenv" ]; then
    export PYENV_ROOT="$HOME/.pyenv"
    [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
    # eval "$(pyenv virtualenv-init -)"
fi

if [ -d "$HOMEBREW_PREFIX/opt/nvm" ]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && \. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
    [ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
fi

if [ -d "$HOMEBREW_PREFIX/opt/postgresql@16/bin" ]; then
    export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
fi

export PGHOST="127.0.0.1"
export PGPORT="5432"


alias cz=chezmoi
alias vim=nvim
alias cat='bat'
alias ping='prettyping --nolegend'
alias du="ncdu --color dark -rr -x --exclude .git --exclude node_modules"
alias ls=eza

if ! [ -x "$(command -v eza)" ]; then
    alias ls='eza'
    alias ld='eza -lD'
    alias lf='eza -lf --color=always | grep -v /'
    alias lh='eza -dl .* --group-directories-first'
    alias ll='eza -al --group-directories-first'
    # alias ls='eza -alf --color=always --sort=size | grep -v /'
    alias lt='eza -al --sort=modified'
fi

alias preview="fzf --preview 'bat --color \"always\" {}'"

export FZF_DEFAULT_OPTS="--bind='ctrl-o:execute(nvim {})+abort'"
export EDITOR="nvim"

source <(fzf --zsh)
eval "$(starship init zsh)"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

ssh-add --apple-load-keychain -q

yoink() {
    osascript -e "set the clipboard to (POSIX file \"$PWD/$1\")"
}

# `tmux a` with no server running: have launchd start the server first (tmux-launchd-start),
# so it isn't part of the terminal app and survives the app being force-quit. Falls back
# to the usual start if that fails.
tmux() {
    if [[ $OSTYPE == darwin* && ( $# -eq 0 || $1 == (a|at|attach|attach-session|new|new-session) ) ]] \
            && ! command tmux has-session 2>/dev/null; then
        tmux-launchd-start || print -u2 "tmux: launchd start failed, starting it the usual way"
    fi
    command tmux "$@"
}
